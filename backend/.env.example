PORT=5000
NODE_ENV=development

# Supabase PostgreSQL (ONLY database)
# Transaction-mode pooler (runtime) - port 6543
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session-mode pooler (used for Prisma migrations) - port 5432
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres"

# Auth
JWT_SECRET="your_strong_secret"
JWT_EXPIRES_IN="1d"

# Cloudinary
CLOUD_NAME=your_cloud_name
API_KEY=your_api_key
API_SECRET=your_api_secret

# Email SMTP
HOST="smtp.gmail.com"
PORT_MAIL=587
EMAIL_USER=you@gmail.com
EMAIL_PASS=app_password